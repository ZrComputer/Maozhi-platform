---
import { site } from "../../data/site";

const services = site.services;
---

<section
  id="services"
  class="services"
  aria-labelledby="services-heading"
>
  <div class="services-decoration" aria-hidden="true">
    <div class="services-glow glow-left"></div>
    <div class="services-glow glow-right"></div>
    <div class="services-grid-lines"></div>
  </div>

  <div class="container services-inner">
    <header class="section-header">
      <div class="section-heading">
        <p class="section-eyebrow">
          <span></span>
          CORE BUSINESS
        </p>

        <h2 id="services-heading">
          三大业务协同
          <span>构建一体化数智能力</span>
        </h2>
      </div>

      <p class="section-introduction">
        以智能化集成为基础，联动机器人与 AI、算电协同能力，
        为工业、园区和政企客户提供从方案设计到实施运维的完整服务。
      </p>
    </header>

    <div class="services-grid">
      {
        services.map((service, index) => (
          <article
            id={service.id}
            class="service-card"
          >
            <div class="card-top">
              <span class="service-number">
                {service.number}
              </span>

              <div class="service-icon" aria-hidden="true">
                {
                  index === 0 ? (
                    <svg
                      viewBox="0 0 48 48"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect
                        x="8"
                        y="9"
                        width="32"
                        height="25"
                        rx="4"
                      />
                      <path d="M18 40h12" />
                      <path d="M24 34v6" />
                      <path d="M14 17h20" />
                      <path d="M14 23h9" />
                      <path d="M28 23h6" />
                      <path d="M14 28h5" />
                      <path d="M24 28h10" />
                    </svg>
                  ) : index === 1 ? (
                    <svg
                      viewBox="0 0 48 48"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 30 9 39" />
                      <path d="m30 18 9-9" />
                      <circle cx="24" cy="24" r="8" />
                      <circle cx="24" cy="24" r="3" />
                      <path d="M16 12h-5a3 3 0 0 0-3 3v5" />
                      <path d="M32 36h5a3 3 0 0 0 3-3v-5" />
                      <path d="M20 8h8" />
                      <path d="M20 40h8" />
                    </svg>
                  ) : (
                    <svg
                      viewBox="0 0 48 48"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M26 5 13 26h10l-1 17 13-22H25z" />
                      <path d="M8 12h7" />
                      <path d="M33 36h7" />
                      <path d="M10 8v8" />
                      <path d="M38 32v8" />
                    </svg>
                  )
                }
              </div>
            </div>

            <div class="card-content">
              <p class="service-eyebrow">
                {service.eyebrow}
              </p>

              <h3>{service.title}</h3>

              <p class="service-description">
                {service.description}
              </p>

              <ul class="service-specialties">
                {
                  service.specialties.map((specialty) => (
                    <li>
                      <span aria-hidden="true"></span>
                      {specialty}
                    </li>
                  ))
                }
              </ul>
            </div>

            <a
              class="service-link"
              href="#solutions"
              aria-label={`查看${service.title}解决方案`}
            >
              <span>了解业务方案</span>

              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>

    <div class="services-footer">
      <p>
        三大业务并非独立分割，可根据项目需求灵活组合，
        形成“智能化 + 机器人 + 能源数字化”的综合解决方案。
      </p>

      <a href="#contact">
        咨询项目方案
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    padding: var(--section-space) 0;

    background:
      radial-gradient(
        circle at 5% 12%,
        rgb(36 111 237 / 11%),
        transparent 28%
      ),
      radial-gradient(
        circle at 94% 87%,
        rgb(116 76 255 / 9%),
        transparent 28%
      ),
      linear-gradient(
        180deg,
        #07101f 0%,
        #0a1528 48%,
        #0b172a 100%
      );

    color: #fff;
  }

  .services-decoration {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .services-grid-lines {
    position: absolute;
    inset: 0;

    opacity: 0.18;

    background-image:
      linear-gradient(
        rgb(114 157 212 / 10%) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgb(114 157 212 / 10%) 1px,
        transparent 1px
      );

    background-size: 72px 72px;

    mask-image:
      linear-gradient(
        180deg,
        rgb(0 0 0 / 70%),
        transparent 86%
      );
  }

  .services-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(12px);
  }

  .glow-left {
    top: 17%;
    left: -180px;

    width: 380px;
    height: 380px;

    background: rgb(25 128 255 / 8%);
  }

  .glow-right {
    right: -170px;
    bottom: 4%;

    width: 360px;
    height: 360px;

    background: rgb(133 86 255 / 7%);
  }

  .services-inner {
    position: relative;
  }

  .section-header {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(300px, 0.85fr);
    align-items: end;
    gap: clamp(35px, 7vw, 100px);

    margin-bottom: clamp(42px, 5vw, 68px);
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;

    margin-bottom: 17px;

    color: #66a7ff;
    font-size: 12px;
    font-weight: 750;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  .section-eyebrow span {
    width: 28px;
    height: 2px;
    flex: none;

    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #4c91ff,
      #9077ff
    );
  }

  .section-header h2 {
    color: #fff;
    font-size: clamp(36px, 4.1vw, 62px);
    font-weight: 760;
    line-height: 1.16;
    letter-spacing: -0.045em;
  }

  .section-header h2 span {
    display: block;
    margin-top: 7px;

    color: transparent;
    background: linear-gradient(
      100deg,
      #72aaff,
      #9a79ff
    );

    background-clip: text;
    -webkit-background-clip: text;
  }

  .section-introduction {
    max-width: 500px;
    padding-bottom: 5px;

    color: #91a2b8;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.85;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 25px);
  }

  .service-card {
    --card-color: #4d94ff;
    --card-color-rgb: 77 148 255;

    position: relative;
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 420px;
    overflow: hidden;

    padding: 26px 30px 30px;

    border:
        1px solid rgb(var(--card-color-rgb) / 22%);
    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        rgb(var(--card-color-rgb) / 8%) 0%,
        rgb(20 34 57 / 96%) 30%,
        rgb(12 24 43 / 98%) 100%
      );

    box-shadow:
      0 20px 45px rgb(0 0 0 / 18%),
      inset 0 1px 0 rgb(255 255 255 / 6%);

    backdrop-filter: blur(12px);

    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .service-card:nth-child(2) {
    --card-color: #856fff;
    --card-color-rgb: 133 111 255;
  }

  .service-card:nth-child(3) {
    --card-color: #26d0d8;
    --card-color-rgb: 38 208 216;
  }

  .service-card::before {
    content: "";

    position: absolute;
    inset: 0 0 auto;

    height: 2px;

    background: linear-gradient(
      90deg,
      transparent,
      var(--card-color),
      transparent
    );

    opacity: 0.75;
  }

  .service-card::after {
  content: "";

  position: absolute;
  top: -75px;
  right: -70px;

  width: 190px;
  height: 190px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgb(var(--card-color-rgb) / 15%),
      transparent 67%
    );

  opacity: 0.82;
  filter: blur(3px);
  pointer-events: none;

  transition:
    transform 240ms ease,
    opacity 240ms ease;
  }

  .service-card:hover {
    transform: translateY(-5px);

    border-color:
      rgb(var(--card-color-rgb) / 42%);

    box-shadow:
        0 28px 60px rgb(0 0 0 / 24%),
        0 0 38px rgb(var(--card-color-rgb) / 8%),
        inset 0 1px 0 rgb(255 255 255 / 8%);
  }

  .service-card:hover::after {
    transform: scale(1.12);
    opacity: 1;
  }

  .card-top {
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .service-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 38px;
    min-height: 24px;
    padding: 4px 8px;

    border: 1px solid
        rgb(var(--card-color-rgb) / 18%);
    border-radius: 999px;

    background:
        rgb(var(--card-color-rgb) / 7%);

    color:
        rgb(var(--card-color-rgb) / 78%);

    font:
        700 11px/1 ui-monospace,
        monospace;

    letter-spacing: 0.13em;
  }

  .service-icon {
    display: grid;
    place-items: center;

    width: 52px;
    height: 52px;

    border: 1px solid
      rgb(var(--card-color-rgb) / 32%);
    border-radius: 15px;

    background:
        linear-gradient(
          145deg,
          rgb(var(--card-color-rgb) / 18%),
          rgb(var(--card-color-rgb) / 7%)
        );

    color: var(--card-color);

    box-shadow:
        0 10px 26px
            rgb(var(--card-color-rgb) / 12%),
        inset 0 1px 0 
            rgb(255 255 255 / 7%);
  }

  .service-icon svg {
    width: 27px;
    height: 27px;
  }

  .card-content {
    position: relative;
    z-index: 1;
    margin-top: 25px;
  }

  .service-eyebrow {
    margin-bottom: 9px;

    color: rgb(var(--card-color-rgb) / 82%);
    font-size: 10px;
    font-weight: 750;
    line-height: 1.5;
    letter-spacing: 0.15em;
  }

  .service-card h3 {
    color: #f4f7fc;
    font-size: clamp(26px, 2vw, 31px);
    font-weight: 730;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .service-description {
    min-height: 78px;
    margin-top: 15px;

    color: #91a3ba;
    font-size: 14px;
    line-height: 1.85;
  }

  .service-specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    margin: 23px 0 0;
    padding: 0;

    list-style: none;
  }

  .service-specialties li {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    min-height: 22px;
    padding: 5px 10px;

    border:
        1px solid rgb(var(--card-color-rgb) / 15%);
    border-radius: 999px;

    background:
        rgb(var(--card-color-rgb) / 6%);

    color: #b9c7d8;
    font-size: 12px;
    line-height: 1.3;
  }

  .service-specialties li span {
    width: 4px;
    height: 4px;
    flex: none;

    border-radius: 50%;

    background: var(--card-color);
    box-shadow:
      0 0 7px rgb(var(--card-color-rgb) / 70%);
  }

  .service-link {
    position: relative;
    z-index: 1;

    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: auto;
    padding-top: 20px;

    border-top: 1px solid rgb(160 187 219 / 11%);

    color: #dce7f5;
    font-size: 14px;
    font-weight: 700;

    transition: color 180ms ease;
  }

  .service-link svg {
    box-sizing: content-box;

    width: 16px;
    height: 16px;
    padding: 7px;

    border:
        1px solid rgb(var(--card-color-rgb) / 20%);
    border-radius: 50%;

    background:
        rgb(var(--card-color-rgb) / 8%);

    color: var(--card-color);

    transition:
        transform 180ms ease,
        background-color 180ms ease;
  }

  .service-link:hover {
    color: var(--card-color);
  }
  
  .service-link:hover svg {
    transform: translateX(4px);

    background:
        rgb(var(--card-color-rgb) / 17%);
  }

  .services-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    margin-top: 34px;
    padding: 22px 26px;

    border: 1px solid rgb(154 184 219 / 12%);
    border-radius: 16px;

    background: rgb(255 255 255 / 3%);
  }

  .services-footer p {
    max-width: 790px;

    color: #8092aa;
    font-size: 14px;
  }

  .services-footer a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: none;

    color: #80b4ff;
    font-size: 14px;
    font-weight: 700;
  }

  .services-footer a:hover {
    color: #fff;
  }

  @media (max-width: 960px) {
    .section-header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 22px;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 0;
    }

    .service-link {
      margin-top: 35px;
    }
  }

  @media (max-width: 700px) {
    .services {
      padding-block: 72px;
    }

    .section-header {
      margin-bottom: 35px;
    }

    .section-header h2 {
      font-size: clamp(34px, 10vw, 46px);
    }

    .section-introduction {
      font-size: 15px;
    }

    .service-card {
      padding: 23px;
      border-radius: 18px;
    }

    .card-content {
      margin-top: 28px;
    }

    .service-description {
        min-height: 0;
    }

    .services-footer {
      align-items: flex-start;
      flex-direction: column;

      margin-top: 22px;
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-link svg {
      transition: none;
    }

    .service-card:hover {
      transform: none;
    }
  }
</style>