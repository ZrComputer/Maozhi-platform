
---
import { site } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">

  <div class="container">

    <div class="footer-main">

      <div class="footer-brand">
        <img
          src="/assets/images/logo.png"
          alt=""
          width="90"
          height="48"
        />

        <div>
          <strong>{site.name}</strong>
          <span>{site.englishName}</span>
        </div>
      </div>

      <div class="footer-links">
        <a href="#about">关于我们</a>
        <a href="#services">业务服务</a>
        <a href="#cases">项目案例</a>
        <a href="#contact">联系我们</a>
      </div>

    </div>

    <div class="footer-bottom">
      <span>
        © {year} {site.name}
      </span>

      <!--
        网站正式备案后，
        在这里添加真实备案号。
      -->
      <span>企业官方网站</span>
    </div>

  </div>

</footer>

<style>
  .site-footer {
    background: #071a32;
    color: #ffffff;
    padding: 55px 0 24px;
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    padding-bottom: 42px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-brand img {
    width: 90px;
    height: 48px;
    object-fit: contain;
    background: transparent;
  }

  .footer-brand div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-brand strong {
    font-size: 22px;
  }

  .footer-brand span {
    color: #8fa8c2;
    font-size: 11px;
  }

  .footer-links {
    display: flex;
    gap: 32px;
  }

  .footer-links a {
    color: #b3c4d6;
    font-size: 14px;
  }

  .footer-links a:hover {
    color: #57c7ff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;

    padding-top: 22px;
    border-top: 1px solid rgba(255,255,255,0.12);

    color: #8da4ba;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .footer-main,
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>