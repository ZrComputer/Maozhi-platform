
---
import SectionShell from "../common/SectionShell.astro";
import { site } from "../../data/site";
---

<SectionShell
  id="about"
  title="关于我们"
  eyebrow="ABOUT US"
  alternate
>

  <!-- 企业数据概览 -->
  <div class="about-metrics">

    {site.metrics.map((item) => (
      <div class="metric-card">

        <div class="metric-value">
          {item.value || (
            <span class="placeholder-line large medium"></span>
          )}
        </div>

        <div class="metric-label">
          {item.label}
        </div>

      </div>
    ))}

  </div>

  <!-- 公司简介及发展历程 -->
  <div class="about-main">

    <article class="about-panel">

      <h3 class="title-accent">企业介绍</h3>

      {site.introduction ? (
        <p class="intro-text">{site.introduction}</p>
      ) : (
        <div class="placeholder-stack intro-empty" aria-hidden="true">
          <span class="placeholder-line long"></span>
          <span class="placeholder-line"></span>
          <span class="placeholder-line long"></span>
          <span class="placeholder-line medium"></span>
          <span class="placeholder-line"></span>
        </div>
      )}

    </article>

    <article class="about-panel">

      <h3 class="title-accent">发展历程</h3>

      <div class="timeline">

        {site.history.map((item) => (
          <div class="timeline-item">

            <span class="timeline-dot"></span>

            <div class="timeline-body">

              {item.year ? (
                <strong>{item.year}</strong>
              ) : (
                <span class="placeholder-line medium"></span>
              )}

              {item.event ? (
                <p>{item.event}</p>
              ) : (
                <span class="placeholder-line long"></span>
              )}

            </div>

          </div>
        ))}

      </div>

    </article>

  </div>

  <!-- 资质展示区域 -->
  <div class="qualification-area">

    <h3 class="title-accent">
      企业资质与荣誉
    </h3>

    <div class="qualification-grid">

      {[1, 2, 3].map((item) => (
        <div class="qualification-card">

          <div class="placeholder-image"></div>

          <div class="qualification-info">
            <span class="placeholder-line medium"></span>
          </div>

        </div>
      ))}

    </div>

  </div>

</SectionShell>

<style>
  .about-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    margin-bottom: 40px;
  }

  .metric-card {
    min-height: 170px;
    padding: 26px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 25px;

    background: #ffffff;
    border: 1px solid #e1eaf4;
    border-radius: 10px;

    box-shadow: 0 8px 25px rgba(7,26,50,0.04);

    transition: transform 0.3s ease;
  }

  .metric-card:hover {
    transform: translateY(-5px);
  }

  .metric-value {
    width: 75%;
    min-height: 28px;

    display: flex;
    justify-content: center;

    color: #2389e9;
    font-size: 28px;
    font-weight: 700;
  }

  .metric-label {
    color: #66788e;
    font-size: 14px;
  }

  .about-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .about-panel {
    min-height: 355px;
    padding: 34px;

    background: #ffffff;
    border: 1px solid #e1eaf4;
    border-radius: 10px;
  }

  .about-panel h3,
  .qualification-area h3 {
    color: #102b49;
    font-size: 21px;
  }

  .intro-text {
    margin-top: 35px;
    color: #5b6d80;
    line-height: 2;
  }

  .intro-empty {
    margin-top: 42px;
  }

  /* 发展历程 */

  .timeline {
    margin-top: 34px;
    padding-left: 15px;
    border-left: 2px solid #d4e5f5;
  }

  .timeline-item {
    position: relative;
    min-height: 75px;
    padding-left: 26px;
    padding-bottom: 10px;
  }

  .timeline-dot {
    position: absolute;
    left: -22px;
    top: 2px;

    width: 12px;
    height: 12px;

    border-radius: 50%;
    background: #2389e9;
    box-shadow: 0 0 0 4px #e6f3ff;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .timeline-body strong {
    color: #2389e9;
  }

  .timeline-body p {
    color: #66788e;
    margin-bottom: 0;
  }

  /* 资质展示 */

  .qualification-area {
    margin-top: 55px;
  }

  .qualification-area h3 {
    margin-bottom: 30px;
  }

  .qualification-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .qualification-card {
    padding: 18px;
    background: #ffffff;

    border: 1px solid #e1eaf4;
    border-radius: 10px;

    box-shadow: 0 8px 25px rgba(7,26,50,0.04);
  }

  .qualification-info {
    padding: 20px 4px 6px;
  }

  @media (max-width: 900px) {
    .about-metrics,
    .qualification-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-main {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .about-metrics,
    .qualification-grid {
      grid-template-columns: 1fr;
    }
  }
</style>