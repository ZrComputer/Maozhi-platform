
---
import SectionShell from "../common/SectionShell.astro";
import { site } from "../../data/site";
---

<SectionShell
  id="services"
  title="核心业务与服务"
  eyebrow="OUR SERVICES"
>

  <div class="services-grid">

    {site.services.map((item, index) => (
      <article class="service-card">

        <div class="service-top">

          <span class="service-icon" aria-hidden="true">
            <svg
              width="34"
              height="34"
              viewBox="0 0 48 48"
              fill="none"
            >
              <path
                d="M24 5L41 14.5V33.5L24 43L7 33.5V14.5L24 5Z"
                stroke="currentColor"
                stroke-width="1.7"
              />
              <path
                d="M7 14.5L24 24L41 14.5M24 24V43"
                stroke="currentColor"
                stroke-width="1.7"
              />
            </svg>
          </span>

          <span class="service-number">
            {String(index + 1).padStart(2, "0")}
          </span>

        </div>

        <div class="service-content">

          {item.title ? (
            <h3>{item.title}</h3>
          ) : (
            <span class="placeholder-line large medium"></span>
          )}

          {item.description ? (
            <p>{item.description}</p>
          ) : (
            <div class="placeholder-stack">
              <span class="placeholder-line long"></span>
              <span class="placeholder-line"></span>
              <span class="placeholder-line medium"></span>
            </div>
          )}

        </div>

        <div class="service-bottom"></div>

      </article>
    ))}

  </div>

</SectionShell>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .service-card {
    position: relative;
    overflow: hidden;

    min-height: 355px;
    padding: 35px;

    background: #ffffff;
    border: 1px solid #e1eaf4;
    border-radius: 12px;

    box-shadow: 0 12px 35px rgba(7,26,50,0.05);

    display: flex;
    flex-direction: column;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-7px);
    border-color: #b6d9fa;
    box-shadow: 0 20px 45px rgba(7,26,50,0.1);
  }

  .service-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 44px;
  }

  .service-icon {
    width: 70px;
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;
    color: #2389e9;
    background: #eaf5ff;
  }

  .service-number {
    color: #edf2f8;
    font-size: 35px;
    font-weight: 700;
    line-height: 1;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 25px;
    flex: 1;
  }

  .service-content h3 {
    font-size: 22px;
    color: #102b49;
    margin: 0;
  }

  .service-content p {
    font-size: 14px;
    line-height: 2;
    color: #718398;
  }

  .service-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;

    height: 3px;
    background: #2389e9;

    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .service-card:hover .service-bottom {
    transform: scaleX(1);
  }

  @media (max-width: 950px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>